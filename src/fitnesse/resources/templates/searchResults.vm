<p id="feedback">Searching...</p>
<table id="searchResultsTable" class="dirListing">
 <thead>
  <tr>
   <th>
	<a href="javascript:void(tableSorter.sort(0));">Type</a>
   </th>
   <th>
	<a href="javascript:void(tableSorter.sort(1));">Page</a>
   </th>
   <th>
	<a href="javascript:void(tableSorter.sort(2));">Tags</a>
   </th>
   <th>
	<a href="javascript:void(tableSorter.sort(3));">Via SymLink</a>
   </th>
   <th>
	<a href="javascript:void(tableSorter.sort(4, 'date'));">LastModified</a>
   </th>
  </tr>
 </thead>
 <tbody>

 #set( $hits = 0 )
 #traverse( $resultResponder )
  #set( $pagePath = $result.getPageCrawler().getFullPath().toString() )
  <tr>
   <td>
   #if($result.getData().hasAttribute("Suite"))
	<a href="$pagePath?suite">Suite</a>
   #end
   #if($result.getData().hasAttribute("Test"))
	<a href="$pagePath?test">Test</a>
   #end
   </td>
   <td>
   #if( $result.isSymbolicPage() )
	<a href="$pagePath">#foreach( $pathPage in $resultResponder.getPathPages($result) )#if( $resultResponder.isSymbolicLink($pathPage) )<span class="symlink" title="symbolic link">$pathPage.getName()</span>#else$pathPage.getName()#end#if( $foreach.hasNext ).#end#end</a>
   #else
	<a href="$pagePath">$pagePath</a>
   #end
   #set( $changes = $resultResponder.getChangedLines($result) )
   #if( $changes )
	<table class="changedLines">
	 <tr><th>Before</th><th>After</th></tr>
	 #foreach( $change in $changes )
	 <tr><td class="before"><pre>$change.getBeforeHtml()</pre></td><td class="after"><pre>$change.getAfterHtml()</pre></td></tr>
	 #end
	</table>
   #end
   </td>
   <td style="text-align: right;">
   #set ( $tags = $result.getData().getAttribute("Suites") )
	<label>#if ($tags && !$tags.equals("null"))#escape($tags)#end</label>
   </td>
   <td>#if($result.isSymbolicPage())yes#{else}no#end</td>
   <td>$result.getData().getProperties().getLastModificationTime()
   </td>
  </tr>
  #set( $hits = $hits + 1 )
 #end

 </tbody>
</table>

<script src="${contextRoot}files/fitnesse/javascript/clientSideSort.js"> </script>
<script language="javascript">
 tableSorter = new TableSorter('searchResultsTable', new DateParser(/^(\w+) (jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec) (\d+) (\d+).(\d+).(\d+) (\w+) (\d+)$/,8,2,3,4,5,6));
</script>

<fieldset>
 <a class="button" href="$viewLocation">Back</a>
</fieldset>


<h4>To save this search as a link, paste the text below into a page.</h4>
<pre>[[Search below !-$page.getName()-! for &lt;description&gt;][$page.getPageCrawler().getFullPath()?$queryString]]</pre>

#if ($hits > 1)
<script language="javascript">document.getElementById("feedback").innerHTML = 'Found $hits results for your search in $resultResponder.getSearchTime() seconds.'</script>
#elseif ($hits == 1)
<script language="javascript">document.getElementById("feedback").innerHTML = 'Found $hits result for your search in $resultResponder.getSearchTime() seconds.'</script>
#else
<script language="javascript">document.getElementById("feedback").innerHTML = 'No pages matched your search criteria. Search took $resultResponder.getSearchTime() seconds.'
 document.getElementById("searchResultsTable").style.display = 'none'</script>
#end
